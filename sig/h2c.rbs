# The ecdsa gem ships no type signatures, so its classes (ECDSA::Group,
# ECDSA::Point and ECDSA::PrimeField) appear here as untyped.
module H2C
  VERSION: String

  class Error < StandardError
  end

  module HashFunc
    SHA256: String
    SHA384: String
    SHA512: String
    SHAKE128: String
    SHAKE256: String
    XMD_FUNCS: Array[String]
    XOF_FUNCS: Array[String]
  end

  # Returns a hash-to-curve function for +suite+ and +dst+.
  def self.get: (String suite, String dst) -> HashToPoint

  module Curve
    Secp256k1_3ISO: untyped
    BLS12381G1: untyped
    BLS12381G1_11ISO: untyped
  end

  class Suite
    SECP256K1_XMDSHA256_SSWU_NU_: String
    SECP256K1_XMDSHA256_SSWU_RO_: String
    BLS12381G1_XMDSHA256_SSWU_NU_: String
    BLS12381G1_XMDSHA256_SSWU_RO_: String
    P256_XMDSHA256_SSWU_NU_: String
    P256_XMDSHA256_SSWU_RO_: String
    P384_XMDSHA384_SSWU_NU_: String
    P384_XMDSHA384_SSWU_RO_: String
    P521_XMDSHA512_SSWU_NU_: String
    P521_XMDSHA512_SSWU_RO_: String

    attr_reader id: String
    attr_reader curve: untyped
    attr_reader k: Integer
    attr_reader exp: Expander::XMD
    attr_reader m: Integer
    attr_reader l: Integer
    attr_reader ro: bool
    attr_reader map: M2C::SSWU | M2C::SSWUAB0

    def initialize: (String id, String dst) -> void
  end

  class HashToPoint
    attr_reader suite: Suite

    def initialize: (Suite suite) -> void
    def digest: (String msg) -> untyped
    def clear_cofactor: (untyped p) -> untyped
    def hash_to_field: (String msg, Integer count, ?Integer modulo) -> Array[Integer]
  end

  module Expander
    MAX_DST_LENGTH: Integer
    LONG_DST_PREFIX: String

    def self.get: (String func, String? dst) -> XMD
    def self.xor: (String x, String y) -> String

    class XMD
      attr_reader dst: String
      attr_reader digest: singleton(Digest::Base)

      def initialize: (String func, String dst) -> void
      def expand: (String msg, Integer len) -> String
      def construct_dst_prime: () -> String
    end
  end

  module M2C
    class SSWU
      attr_reader curve: untyped
      attr_reader c1: Integer
      attr_reader c2: Integer
      attr_reader z: Integer

      def initialize: (untyped curve, Integer z) -> void
      def map: (Integer u) -> untyped
      def square?: (Integer x) -> bool
      def sgn0: (Integer x) -> Integer
    end

    class SSWUAB0
      attr_reader sswu: SSWU
      attr_reader iso: Isogeny::Secp256k1 | Isogeny::BLS12381G1

      def initialize: (Isogeny::Secp256k1 | Isogeny::BLS12381G1 iso, Integer z) -> void
      def map: (Integer u) -> untyped
    end

    module Isogeny
      class Secp256k1
        X_NUM: Array[Integer]
        X_DEN: Array[Integer]
        Y_NUM: Array[Integer]
        Y_DEN: Array[Integer]

        attr_reader e0: untyped
        attr_reader e1: untyped

        def initialize: () -> void
        def map: (Integer x, Integer y) -> [Integer, Integer]
      end

      class BLS12381G1
        X_NUM: Array[Integer]
        X_DEN: Array[Integer]
        Y_NUM: Array[Integer]
        Y_DEN: Array[Integer]

        attr_reader e0: untyped
        attr_reader e1: untyped

        def initialize: () -> void
        def map: (Integer x, Integer y) -> [Integer, Integer]
      end
    end
  end
end
